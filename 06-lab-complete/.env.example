# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env rồi điền giá trị thật.
# File .env đã nằm trong .gitignore và .dockerignore — KHÔNG commit secret.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — bắt buộc. Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis — trong docker compose là redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa mỗi API key trong 60 giây
RATE_LIMIT_PER_MINUTE=10

# Cost guard: ngân sách LLM mỗi ngày (USD) và giá token (USD / 1K token)
DAILY_BUDGET_USD=1.0
PRICE_INPUT_PER_1K=0.00015
PRICE_OUTPUT_PER_1K=0.0006
